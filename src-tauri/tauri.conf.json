{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri/main/crates/tauri-config-schema/schema.json",
  "productName": "Sidebar Memo",
  "version": "1.0.4",
  "identifier": "com.sidebar.memo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sidebar Memo",
        "width": 400,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "maximizable": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "image-viewer",
        "title": "Image Preview",
        "url": "viewer.html",
        "width": 960,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "maximizable": true,
        "minimizable": true,
        "center": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "quick-note",
        "title": "Quick Note",
        "url": "quick-note.html",
        "width": 320,
        "height": 300,
        "minWidth": 260,
        "minHeight": 200,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost http://asset.localhost https://asset.localhost https://github.com ws://localhost:1420 http://localhost:1420",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/sidebar-memo/images/**"]
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/AdamKnightxsl/SidebarMemo/main/update/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZERjZENkY5RkE1MjEyMDQKUldRRUVsTDYrZGIyYmNGQUxLS2UxWklLaU5DNHVObUJiTldIVEFRektTZUpBTGxzNGEwdm9SeGEK",
      "windows": {
        "installMode": "basicUi"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": ["models/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese"]
      }
    }
  }
}
